PORT=8000
RFID_LENGTH=10
PIN_LENGTH=4
# global: all PINs must be unique.
# scheduled: scheduled-access PINs must be unique; ordinary resident duplicates are allowed.
# off: ordinary duplicate checks are disabled, but scheduled-access PINs are still protected.
PIN_UNIQUENESS_MODE=scheduled
# generated: guest PINs are always generated by the backend.
# custom_until_scheduled: guests may choose PINs only while they have no schedules.
GUEST_PIN_MODE=generated
INPUT_TIMEOUT=10  # seconds within which the PIN must be entered

# AWS credentials for the SES service
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_SENDER_EMAIL=
AWS_REGION=

# Login email links
# WEB_APP_URL is used with /login.
WEB_APP_URL=http://localhost:3000

# Direct native push notifications. The React Native app registers APNs tokens
# on iOS and FCM tokens on Android; this backend sends directly to Apple/Google.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=
APNS_KEY_FILE=
# APNS_PRIVATE_KEY can be used instead of APNS_KEY_FILE. Escape newlines as \n.
APNS_PRIVATE_KEY=
APNS_DEFAULT_ENVIRONMENT=production
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# FCM_SERVICE_ACCOUNT_JSON can be used instead of FCM_SERVICE_ACCOUNT_FILE.
FCM_SERVICE_ACCOUNT_JSON=
# Set to 1 to use Google Application Default Credentials instead.
FCM_USE_ADC=

# GPIO pin for the relay
RELAY_PIN=18
RELAY_ACTIVE_STATE=LOW  # LOW or HIGH - depends on the type of relay
RELAY_ACTIVATION_TIME=10

# Reader mode - stdin for keyboard input from the terminal, evdev for a USB keyboard input, or t9em (see readme)
INPUT_SOURCE=evdev
