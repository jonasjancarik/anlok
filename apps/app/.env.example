# React Native (Expo) env
# Backend API base URL
# iOS simulator: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Expo web: active server URL for hosted browser builds.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional UI labels
EXPO_PUBLIC_APP_TITLE="Door Access"
EXPO_PUBLIC_APP_SUBTITLE=""
EXPO_PUBLIC_SENDER_EMAIL=admin@example.com
EXPO_PUBLIC_REQUIRED_PIN_LENGTH=4
# generated: guest PINs are always generated by the backend.
# custom_until_scheduled: guests may choose PINs only while they have no schedules.
EXPO_PUBLIC_GUEST_PIN_MODE=generated

# iOS APNs endpoint selection for native device tokens.
# Defaults to sandbox in dev builds and production in release builds.
EXPO_PUBLIC_APNS_ENVIRONMENT=

# Native app identifiers used by app.config.js for signed builds.
EXPO_IOS_BUNDLE_IDENTIFIER=
EXPO_ANDROID_PACKAGE=com.anonymous.anlok

# Optional path used by app.config.js for Android FCM config.
EXPO_GOOGLE_SERVICES_FILE=./google-services.json
